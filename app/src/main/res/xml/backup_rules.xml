<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 half of the same rule as data_extraction_rules.xml: nothing
  leaves this device. android:allowBackup is already false, so this should never
  be consulted — it exists so the intent is stated in both places rather than
  depending on which one a given platform version happens to read.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
